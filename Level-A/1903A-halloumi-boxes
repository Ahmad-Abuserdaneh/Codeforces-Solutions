/*
	dicription: in this code it asked to check if the inputed numbers are sorted or not and that if k(number or numbers you can switch any number of times) has the ability
			to change the outcome, I came to the conclution that if k is bigger than or equal to 2 you can sort any set of numbers, if you can switch any 2 numbers any number
			of times you can keep switching until the numbers are sorted in the end,so I made a loop to check if the numbers are already sorted the condition is true and
			it prints out yes,if not I check if k is bigger than or equal to 2 if true it also prints yes, if none of them are true the code prints false
*/

#include <iostream>
#include <vector>
using namespace std;
int main() {
	int t;
	cin >> t;

	
	for (int i = 0;i < t;i++) {
		bool thisone = true;
		int n, k;
		cin >> n >> k;
		vector<int>f(n);
		for (int z = 0;z < n;z++) {
			cin >> f[z];
		}
		if (k >= 2) {
			thisone = true;
		}
		else {
			for (int x = 0;x <= n - 2;x++) {
				if (f[x] > f[x + 1]) {
					thisone = false;
					break;
				}
			}
		}
		if (thisone) {
			cout << "YES" << endl;
			}
		else {
			cout << "NO" << endl;
		}


	}
}
